{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rustwarp",
  "version": "0.1.0",
  "identifier": "com.jaichuen.rustwarp",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "rustwarp",
        "width": 800,
        "height": 600,
        "minWidth": 800,
        "minHeight": 400,
        "resizable": true,
        "maximizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../src/data/command/**/*"
    ]
  }
}
