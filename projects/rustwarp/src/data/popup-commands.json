{
  "commands": [
    {
      "command": "findall",
      "description": "Find in filtered filename or all for a keyword or more from built-in editor in the current directory",
      "example": "findall in *.c *.h *.sh",
      "category": "file-search"
    },
    {
      "command": "get",
      "description": "Get a file or more from everthing",
      "example": "get report.xlsx data.cfg",
      "category": "file-search"
    },
    {
      "command": "run",
      "description": "Run an application or more",
      "example": " team jira gitlab",
      "category": "system-app"
    },
    {
      "command": "install",
      "description": "Install an application",
      "example": "install python latest",
      "category": "system-app"
    },
    {
      "command": "zip",
      "description": "Create ZIP archives",
      "example": "zip -r archive.zip folder/",
      "category": "compression"
    },
    {
      "command": "unzip",
      "description": "Extract ZIP archives",
      "example": "unzip archive.zip",
      "category": "compression"
    },
    {
      "command": "ci",
      "description": "Launch or list CI/CD pipeline",
      "example": "ci compile arch",
      "category": "ci-cd"
    }
  ]
}
